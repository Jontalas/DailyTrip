PORT=3000

# Recomendado: Geoapify es la fuente principal de POIs.
# Plan gratuito disponible; crea una clave y pégala aquí.
GEOAPIFY_API_KEY=

# Opcional: respaldo adicional. Requiere proyecto/billing de Google Maps Platform.
GOOGLE_PLACES_API_KEY=

# Opcional: curación por IA (Google Gemini). Proveedor ADITIVO: propone nombres
# de lugares que luego se geocodifican y validan; su nota ordena las listas.
# Sin clave, el descubrimiento funciona igual con Wikipedia/Geoapify/OSM.
# Clave en https://aistudio.google.com/apikey  ·  Modelo por defecto: gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Servicios de geometría/rutas
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# Overpass queda como tercer nivel de respaldo
OVERPASS_URL=https://overpass-api.de/api/interpreter

APP_USER_AGENT=TravelPlannerPersonal/1.2.44 (personal-use)
DEBUG_EXTERNAL=0
