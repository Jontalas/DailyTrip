PORT=3000

# Recomendado: Geoapify es la fuente principal de POIs.
# Plan gratuito disponible; crea una clave y pégala aquí.
GEOAPIFY_API_KEY=

# Opcional: respaldo adicional. Requiere proyecto/billing de Google Maps Platform.
GOOGLE_PLACES_API_KEY=

# Servicios de geometría/rutas
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# Overpass queda como tercer nivel de respaldo
OVERPASS_URL=https://overpass-api.de/api/interpreter

APP_USER_AGENT=TravelPlannerPersonal/1.2.25 (personal-use)
DEBUG_EXTERNAL=0
